--- a/.github/workflows/docker-image.yml
+++ b/.github/workflows/docker-image.yml
@@ -48,6 +48,17 @@ jobs:
             --network=none \
             mutalambda:ci examples
 
+      - name: Scan image for vulnerabilities (Trivy)
+        # ML-003: blocking container SCA. HIGH/CRITICAL CVEs fail the job so
+        # the image is never pushed while it carries known vulnerabilities.
+        uses: aquasecurity/trivy-action@0.28.0
+        with:
+          image-ref: "mutalambda:ci"
+          format: "table"
+          exit-code: "1"
+          ignore-unfixed: true
+          severity: "CRITICAL,HIGH"
+
       - name: Login to GHCR
         if: github.event_name == 'push' && github.ref == 'refs/heads/main'
         uses: docker/login-action@v3
